Version: 1.0

RVersion: 4.2.0

RestoreWorkspace: No
SaveWorkspace: No
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

AutoAppendNewline: Yes
LineEndingConversion: Posix

BuildType: Package

BuildCommand: source('global.R')
BuildResults: BuildPane
BuildTools: RScript
DefaultWorkingDirectory: .
EnableBuildPane: Yes
EnableRMarkdown: Yes
EnableShiny: Yes
IndexCache: Yes
PackageType: Source
RMarkdownRenderCommand: rmarkdown::render
RMarkdownShowOutput: Yes
SharedProjectSettings: Yes
ShinyRunCommand: shiny::runApp('app.R')
TabSize: 2
Type: Project
UsePackrat: No
UseRenviron: Yes
VersionControl: Git
